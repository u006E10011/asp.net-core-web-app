@model DevLog.ViewModels.Admin.AdminIndexViewModel
@{
    ViewData["Title"] = "Админка";
}

<section class="admin-shell">
    <div class="admin-shell__header">
        <div>
            <p class="admin-section__eyebrow">Content management</p>
            <h1 class="admin-section__title">Посты DevLog</h1>
            <p class="hint-text">Управление лентой, тегами, изображениями и счётчиками реакций.</p>
        </div>

        <a asp-action="Create" asp-controller="Admin" class="button-primary">Создать пост</a>
    </div>

    @if (Model.Posts.Count == 0)
    {
        <div class="empty-state">
            <h2>Постов пока нет</h2>
            <p>Создайте первую публикацию, чтобы наполнить публичную ленту и базу данных.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Дата</th>
                        <th>Теги</th>
                        <th>Рейтинг</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model.Posts)
                    {
                        <tr>
                            <td>@post.Title</td>
                            <td>
                                <div>@post.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                @if (post.UpdatedAtUtc.HasValue)
                                {
                                    <div class="hint-text">обновлено @post.UpdatedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                }
                            </td>
                            <td>
                                <div class="table-tags">
                                    @foreach (var tag in post.Tags)
                                    {
                                        <span class="tag-pill">#@tag</span>
                                    }
                                </div>
                            </td>
                            <td>▲ @post.LikesCount / ▼ @post.DislikesCount</td>
                            <td>
                                <div class="admin-actions">
                                    <a asp-action="Edit" asp-route-id="@post.Id" class="button-secondary">Изменить</a>
                                    <form asp-action="Delete" asp-route-id="@post.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="button-danger">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
